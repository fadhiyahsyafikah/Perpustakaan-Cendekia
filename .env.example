DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@localhost:5432/perpustakaan_cendekia

# --- Keamanan sesi -------------------------------------------
# Kunci rahasia penanda tangan cookie sesi. WAJIB diisi, minimal 32 karakter acak.
SESSION_SECRET=GANTI_DENGAN_TEXT_ACAK_MINIMAL_32_KARAKTER

# Isi true hanya jika aplikasi dipasang di server HTTPS (cookie hanya dikirim lewat HTTPS).
COOKIE_SECURE=false

# --- Pengaturan aplikasi -------------------------------------
# Domain email kampus untuk pendaftaran Mahasiswa. Email harus berakhiran domain ini.
# Contoh "ac.id" menerima nama@kampus.ac.id. Boleh lebih dari satu, pisahkan dengan koma.
CAMPUS_EMAIL_DOMAIN=ac.id

# Zona waktu untuk menampilkan tanggal dan jam (perhitungan tanggal di database
# memakai fungsi wita_today() pada berkas .sql dengan zona Asia/Makassar).
APP_TIMEZONE=Asia/Makassar